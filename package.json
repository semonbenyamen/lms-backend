    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
