  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typeorm": "typeorm-ts-node-esm",
    "migration:generate": "pnpm exec typeorm-ts-node-esm migration:generate -d src/database/data-source.ts",
    "migration:run": "pnpm exec typeorm-ts-node-esm migration:run -d src/database/data-source.ts",
    "migration:revert": "pnpm exec typeorm-ts-node-esm migration:revert -d src/database/data-source.ts",
    "prepare": "husky",
    "seed:auth": "node scripts/seed-auth.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
